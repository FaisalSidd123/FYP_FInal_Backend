# Copy this file to .env and fill in the values from your Firebase Service Account JSON
# You can generate a new private key from Firebase Console -> Project Settings -> Service Accounts

FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# For the private key, wrap the ENTIRE key in quotes and preserve the \n characters as literal \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nVery\nLong\nKey\nEnds\nHere\n-----END PRIVATE KEY-----\n"
